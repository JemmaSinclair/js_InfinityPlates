# ====================================================================
# js_InfinityPlates .gitignore
# ====================================================================

# Visual Studio / IDE temporary files and directories
.vs/
.vscode/
*.VC.db
*.VC.opendb
*.sln.docstates
*.user
*.suo

# C++ Build intermediate files and artifacts
*.obj
*.res
*.lib
*.exp
*.pdb
*.idb
*.ilk
*.pch
*.ipch

# Logs and runtime dumps
*.log
*.dump
*.dmp
CustomPlates.log

# Temporary and backup files
*.tmp
*.bak
*.cache
*~

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Intermediate binaries in src/
src/*.asi
src/*.dll
src/*.exe

# Explicitly ensure release binaries are included
!bin/CustomPlates.asi

# Custom plate texture dictionaries (.ytd)
# Note: State-specific texture packs are not redistributed - users supply their own.
sample_resource/**/stream/*.ytd
!sample_resource/**/stream/custom_plates.ytd
*.png
